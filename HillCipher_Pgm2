import java.util.Scanner;

public class HillCipher {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        // Key matrix
        int[][] key = {
            {3, 3},
            {2, 5}
        };

        // Inverse of key matrix modulo 26
        int[][] inverse = {
            {15, 17},
            {20, 9}
        };

        System.out.print("Enter plaintext (2 letters): ");
        String text = sc.nextLine().toUpperCase();

        // Convert letters to numbers
        int a = text.charAt(0) - 'A';
        int b = text.charAt(1) - 'A';

        // Encryption
        int c1 = (key[0][0] * a + key[0][1] * b) % 26;
        int c2 = (key[1][0] * a + key[1][1] * b) % 26;

        String encrypted = "" + (char)(c1 + 'A') + (char)(c2 + 'A');

        System.out.println("Encrypted Text: " + encrypted);

        // Decryption
        int d1 = (inverse[0][0] * c1 + inverse[0][1] * c2) % 26;
        int d2 = (inverse[1][0] * c1 + inverse[1][1] * c2) % 26;

        String decrypted = "" + (char)(d1 + 'A') + (char)(d2 + 'A');

        System.out.println("Decrypted Text: " + decrypted);
    }
}
